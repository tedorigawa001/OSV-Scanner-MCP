{
  "name": "osv-scanner-mcp",
  "version": "0.21.2",
  "description": "MCP server that wraps Google's OSV-Scanner to scan Java, JavaScript, Python, Go, Rust, .NET, and PHP dependencies for known vulnerabilities and recommend fixes",
  "type": "module",
  "license": "Apache-2.0",
  "author": "tedorigawa001",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "osv",
    "osv-scanner",
    "vulnerability",
    "security",
    "maven",
    "java",
    "npm",
    "python",
    "go",
    "rust",
    "nuget",
    "dotnet",
    "php",
    "composer",
    "sca"
  ],
  "files": [
    "dist",
    "gradle/export-dependency-graph.init.gradle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedorigawa001/OSV-Scanner-MCP.git"
  },
  "homepage": "https://github.com/tedorigawa001/OSV-Scanner-MCP#readme",
  "bugs": {
    "url": "https://github.com/tedorigawa001/OSV-Scanner-MCP/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "osv-scanner-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "3.3.3",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  }
}
